# State-driven surgery.

surgery-state-skin-cut = Skin is cut
surgery-state-skin-open = Skin is open
surgery-state-vessels-unclamped = Blood vessels are unclamped
surgery-state-vessels-clamped = Blood vessels are clamped
surgery-state-organs-cut = Organs are cut
surgery-state-bone-drilled = Bone is drilled
surgery-state-bone-sawed = Bone is sawed
surgery-state-plastic-applied = Plastic is applied
surgery-state-prosthetic-unsecured = Prosthetic is unsecured
surgery-state-cavity-widened = Cavity is opened wide

surgery-state-lacks-skin = Bodypart lacks skin (counts as open)
surgery-state-lacks-bones = Bodypart lacks bones (counts as sawed)
surgery-state-lacks-vessels = Bodypart lacks blood vessels (counts as clamped)
surgery-state-intact = No surgical state

surgery-tool-hands = hands

wf-surgery-op-incise-skin = make skin incision
wf-surgery-op-incise-skin-desc = Make an incision in the patient's skin to access internal organs. Causes "skin cut" surgical state.
wf-surgery-op-retract-skin = retract skin
wf-surgery-op-retract-skin-desc = Retract the patient's skin to access their internal organs. Causes "skin open" surgical state.
wf-surgery-op-clamp-bleeders = clamp bleeders
wf-surgery-op-clamp-bleeders-desc = Clamp bleeding blood vessels to prevent blood loss. Causes "vessels clamped" surgical state.
wf-surgery-op-unclamp-bleeders = unclamp bleeders
wf-surgery-op-unclamp-bleeders-desc = Unclamp blood vessels to allow blood flow again. Clears "vessels clamped" surgical state.
wf-surgery-op-saw-bone = saw limb bone
wf-surgery-op-saw-bone-desc = Saw through the patient's bones to access their internal organs. Causes "bone sawed" surgical state.
wf-surgery-op-drill-bone = drill limb bone
wf-surgery-op-drill-bone-desc = Drill through a patient's bones. Causes "bone drilled" surgical state.
wf-surgery-op-incise-organs = incise organs
wf-surgery-op-incise-organs-desc = Make an incision in the patient's internal organ tissue. Causes "organs cut" surgical state.
wf-surgery-op-organ-manipulation = organ manipulation
wf-surgery-op-organ-manipulation-desc = Remove an organ from the patient, or insert the organ you are holding.
wf-surgery-op-mend-skin = mend skin incision
wf-surgery-op-mend-skin-desc = Mend the incision in the patient's skin, closing it up. Clears most surgical states.
wf-surgery-op-fix-bones = fix limb bone
wf-surgery-op-fix-bones-desc = Repair a patient's cut or broken bones. Clears "bone sawed" and "bone drilled" surgical states.
wf-surgery-op-unscrew-shell = unscrew shell
wf-surgery-op-unscrew-shell-desc = Unscrew the shell of a mechanical patient to access its internals. Causes "cut skin" surgical state.
wf-surgery-op-open-hatch = open hatch
wf-surgery-op-open-hatch-desc = Open the hatch of a mechanical patient. Causes "skin open" and "vessels clamped" surgical states.
wf-surgery-op-prepare-electronics = prepare electronics
wf-surgery-op-prepare-electronics-desc = Prepare the internal electronics of a mechanical patient. Causes "organs cut" surgical state.
wf-surgery-op-unwrench-endoskeleton = unwrench endoskeleton
wf-surgery-op-unwrench-endoskeleton-desc = Unwrench a mechanical patient's endoskeleton to access its internals. Causes "bone sawed" surgical state.
wf-surgery-op-wrench-endoskeleton = wrench endoskeleton
wf-surgery-op-wrench-endoskeleton-desc = Wrench a mechanical patient's endoskeleton back into place. Clears "bone sawed" surgical state.
wf-surgery-op-screw-shell = screw shell
wf-surgery-op-screw-shell-desc = Screw the shell of a mechanical patient back into place. Clears most surgical states.

surgery-option-remove-organ = remove { $organ }
surgery-option-remove-organ-desc = Remove { $organ } from the patient.
surgery-option-insert-organ = insert { $organ }
surgery-option-insert-organ-desc = Insert { $organ } into the patient.
surgery-option-tend-both = tend bruises and burns
surgery-option-tend-both-desc = Heal a patient's superficial bruises, cuts and burns.
surgery-option-tend-brute = tend bruises
surgery-option-tend-brute-desc = Heal a patient's superficial bruises and cuts.
surgery-option-tend-burn = tend burns
surgery-option-tend-burn-desc = Heal a patient's superficial burns.
surgery-option-remove-cavity-item = remove { $item }
surgery-option-remove-cavity-item-desc = Remove { $item } from the patient's chest cavity.


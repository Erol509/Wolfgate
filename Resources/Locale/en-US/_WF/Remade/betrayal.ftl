# Remade betrayal: the dead's own voices, false announcements and the body giving way.

wf-betrayal-area-door = by the {$door}
wf-betrayal-area-grid = aboard the {$ship}
wf-betrayal-area-unknown = somewhere in the dark

wf-betrayal-lure-1 = ...help... I'm {$area}... please...
wf-betrayal-lure-2 = ...is anyone there... {$area}... it hurts...
wf-betrayal-lure-3 = ...please... I'm {$area}... don't leave me...
wf-betrayal-lure-4 = ...I can't move... {$area}... somebody...
wf-betrayal-lure-5 = ...they're gone now... I'm {$area}... come quickly...
wf-betrayal-lure-6 = ...I'm {$area}... it's so cold... please...

wf-betrayal-announce-1 = Evacuation shuttle docking at the Frontier Outpost in 2 minutes. Proceed to the departure lounge.
wf-betrayal-announce-2 = Hull breach detected on deck 3. Seal your suits and await rescue.
wf-betrayal-announce-3 = All hands, the quarantine is lifted. Return to your stations.
wf-betrayal-announce-4 = The Frontier Outpost is in lockdown. Do not approach the docking ring.
wf-betrayal-announce-5 = Emergency shuttle arriving in 90 seconds. Boarding is first come, first served.
wf-betrayal-announce-6 = Medical teams are on their way. Stay where you are.
wf-betrayal-announce-7 = Power failure across the sector. Rescue is delayed.
wf-betrayal-announce-8 = This is a recorded message. Nobody is coming.

wf-betrayal-pda-wrap = [color=#6a9fd6]\[PDA\] {$name}:[/color] {$message}
wf-betrayal-pda-1 = Where did everyone go? I can't find anyone.
wf-betrayal-pda-2 = It's cold in here. Come and get me.
wf-betrayal-pda-3 = I'm behind the door. Open it.
wf-betrayal-pda-4 = Did you see what they did to me?
wf-betrayal-pda-5 = Don't trust the lights.
wf-betrayal-pda-6 = I can hear you walking. Wait for me.
wf-betrayal-pda-7 = They fixed me. Come and see.
wf-betrayal-pda-8 = You left me there.

wf-betrayal-drop = Your hand lets go of { THE($item) }.
wf-betrayal-nosebleed = Your nose is bleeding.
wf-betrayal-twitch = Your body jerks without you.

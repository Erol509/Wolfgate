wf-signal-role-name = Signal
wf-signal-role-description = The Hymn has you. Fly near its stone, scare the living, and take over the Remade.
wf-signal-role-rules = You work for the stone and the Remade, and you want the living afraid. You can't be seen or touched. You stay near the stone, its ship and its corruption. Don't pass what you see on to the living.

ent-WFSignal = signal
    .desc = You shouldn't see this.
ent-WFSignalGate = signal gate
    .desc = A way into the Hymn.

wf-signal-busy = You are busy.
wf-signal-too-quiet = The stone is too quiet for that.
wf-signal-cooldown = Not yet.
wf-signal-no-psi = You don't have the strength.
wf-signal-sanctuary = The Hymn doesn't reach here.
wf-signal-far = Too far.
wf-signal-nothing = Nothing happens.
wf-signal-not-yours = You can't take that one.
wf-signal-pulled = The Hymn does not carry you further.
wf-signal-ability-none = Nothing to use it on.
wf-signal-stone-gone = The stone is gone. You are let go.
wf-signal-stone-quiet = The stone has gone quiet. You are let go.

wf-signal-hud-title = SIGNAL
wf-signal-hud-psi = Psi {$psi} / {$max}
wf-signal-hud-stage-Quiet = Quiet
wf-signal-hud-stage-Hymn = Hymn
wf-signal-hud-stage-Growth = Growth
wf-signal-hud-stage-Harvest = Harvest
wf-signal-hud-stage-Rapture = Rapture
wf-signal-hud-stage-Crescendo = Crescendo

ent-WFSignalActionFlicker = Flicker
    .desc = Make the lights near something flicker.
ent-WFSignalActionWhisper = Whisper
    .desc = Put a line in one person's head.
ent-WFSignalActionFalseSound = False sound
    .desc = A Remade's voice, close to one person.
ent-WFSignalActionScrawl = Scrawl
    .desc = Write on the floor near something.
ent-WFSignalActionDoor = Open or shut
    .desc = A door moves with nobody touching it.
ent-WFSignalActionBolt = Bolt
    .desc = Bolt a door shut for a while.
ent-WFSignalActionPossess = Take over
    .desc = Drive a Remade near you.
ent-WFSignalActionRelease = Let go
    .desc = Give the Remade back and return to the Hymn.

ent-WFSignalActionLeap = Leap
    .desc = Jump at someone.
ent-WFSignalActionPounce = Pounce
    .desc = Pounce on someone.
ent-WFSignalActionBlink = Blink
    .desc = Jump a few tiles.
ent-WFSignalActionCharge = Charge
    .desc = Run at someone.
ent-WFSignalActionRam = Ram
    .desc = Run through whatever is in the way.
ent-WFSignalActionDodge = Dodge
    .desc = Step aside from a shot.
ent-WFSignalActionShout = Shout
    .desc = Scream at everyone near.
ent-WFSignalActionTaunt = Taunt
    .desc = Rally the Remade near you.
ent-WFSignalActionTailStab = Tail stab
    .desc = Stab someone with your tail.
ent-WFSignalActionSwing = Swing
    .desc = Swing your limbs around you.
ent-WFSignalActionShoot = Spit
    .desc = Spit acid at someone.
ent-WFSignalActionVomit = Vomit
    .desc = Vomit a cone of acid.
ent-WFSignalActionSpine = Spines
    .desc = Open up and fire spines.
ent-WFSignalActionTongue = Tongue
    .desc = Haul someone in with your tongue.
ent-WFSignalActionLatch = Latch
    .desc = Latch onto someone.
ent-WFSignalActionExplode = Burst
    .desc = Swell and burst.

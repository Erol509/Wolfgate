ent-WFMonolithShard = monolith shard
    .desc = A chip of black stone cut with writing. Warm to the touch. Slot it where a power cell goes and it never runs down.

wf-monolith-tap-climb = rising {$rate}% a minute

wf-monolith-gift-power = Power
wf-monolith-gift-matter = Matter
wf-monolith-gift-flesh = Flesh
wf-monolith-gift-reach = Reach
wf-monolith-gift-ward = Ward

wf-monolith-warning-quiet = The stone is quiet. It is only a rock until it is used.
wf-monolith-warning-hymn = The stone hums. Some of the crew hear singing.
wf-monolith-warning-growth = Corruption is growing out from the stone. Bodies left on it turn.
wf-monolith-warning-harvest = The stone is feeding its growth, and the Remade are hunting the crew.
wf-monolith-warning-rapture = The stone is nearly awake. Get it off the ship.
wf-monolith-warning-crescendo = The stone has rooted. Matter, Flesh, Reach and Ward run at full and their dials are locked. Nothing quiets it now.
wf-monolith-warning-flesh = Anyone the stone raises is marked. When they die again they get up as Remade.
wf-monolith-warning-shards = {$count ->
    [one] One shard has been cut from the stone, and cutting more adds resonance.
    *[other] {$count} shards have been cut from the stone, and cutting more adds resonance.
}

wf-noresale-examine = The stone made this. No buyer will touch it.
wf-matter-no-eject = That is the stone's matter. It won't come out as sheets.

wf-flesh-rise = {CAPITALIZE($target)} gasps. It is not a breath of life.
wf-flesh-marked-examine = Something is wrong with {POSS-ADJ($target)} eyes. They don't quite follow you.

wf-shard-chip-loose = Wrench the stone down first. It shifts when you push on it.
wf-shard-chip-barred = The stone is silent here. Nothing comes away.
wf-shard-chip-none-left = Nothing more will come away. Not yet.
wf-shard-chip-start = You set {THE($tool)} against the stone and start cutting.
wf-shard-chipped = A shard comes away. The stone hums louder.
wf-shard-rooted = Black threads push out of the shard and into the deck.
wf-shard-cut-free = You cut the shard free. The threads go slack.
wf-shard-stuck = It is rooted in the deck. You would have to cut it free.
wf-shard-examine = A chip of the stone. Slot it where a power cell goes and it never runs down. Left still near a stone that has woken, it takes root.
wf-shard-examine-rooted = Black threads hold it to the deck. You would need something sharp to cut it free.

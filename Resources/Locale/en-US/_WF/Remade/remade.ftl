ent-WFMonolithScion = monolith scion
    .desc = A black stone taller than you, cut with writing nobody can read. It hums. Everything you wire to it runs for free.
ent-WFMonolithSplinter = monolith splinter
    .desc = A sliver of black stone grown up through the deck, cut with writing. It hums, and something answers in the vents.
ent-WFMonolithTap = monolith tap
    .desc = A console wired into a Monolith. Set how hard you draw on it. A body dragged onto it quiets the stone for a while.
ent-WFCorruption = corruption
    .desc = Living tissue spreading over the deck. Fire kills it.
ent-WFRemadeSlasher = slasher
    .desc = It used to be crew. Now it has blades growing out of its back.
ent-WFRemadeSlasherEnhanced = black slasher
    .desc = A slasher grown hard and dark. Its blades go through armour.
ent-WFRemadeInfector = infector
    .desc = A winged thing with a proboscis. Kill it before it reaches the dead.

wf-monolith-tap-title = Monolith Tap
wf-monolith-tap-draw = Draw
wf-monolith-tap-draw-step = {$percent}%
wf-monolith-tap-resonance = RESONANCE {$resonance}%
wf-monolith-tap-output = Power output: {$megawatts} MW
wf-monolith-tap-no-scion = No Scion in reach.
wf-monolith-tap-barred = Too close to Frontier Outpost. The stone stays silent within 500 m of it.
wf-monolith-tap-feed-hint = Drag a corpse onto the Tap to bring resonance down.
wf-monolith-tap-refused = The stone takes nothing now. It is past that.
wf-monolith-tap-fed = The Tap draws {THE($corpse)} in. The hum drops.

wf-monolith-stage-quiet = Quiet
wf-monolith-stage-hymn = Hymn
wf-monolith-stage-growth = Growth
wf-monolith-stage-harvest = Harvest
wf-monolith-stage-rapture = Rapture
wf-monolith-stage-crescendo = Crescendo

wf-monolith-sold-alert = A monolith scion was sold at {$station}.
wf-monolith-crescendo-sender = Sector Watch
wf-monolith-crescendo-announcement = All ships: a Monolith has rooted itself. Dead crew in that area are getting back up. Do not board. Do not dock.

wf-monolith-whisper-1 = You hear singing. It stops when you listen.
wf-monolith-whisper-2 = Someone says your name, right behind you.
wf-monolith-whisper-3 = You can't remember why you came in here.
wf-monolith-whisper-4 = Join the song.
wf-monolith-whisper-5 = You know the writing on the stone. You don't remember learning it.
wf-monolith-whisper-6 = Something in the vents is breathing with you.
wf-monolith-whisper-7 = Draw more. It would be so easy.
wf-monolith-whisper-8 = The dead aren't finished.

wf-remade-writhing-1 = {CAPITALIZE(THE($corpse))} twitches.
wf-remade-writhing-2 = {CAPITALIZE(THE($corpse))} jerks violently.
wf-remade-writhing-3 = {CAPITALIZE(THE($corpse))} convulses.
wf-remade-writhing-4 = Something moves under the skin of {THE($corpse)}.
wf-remade-writhing-5 = The bones of {THE($corpse)} crack and shift.
wf-remade-writhing-6 = {CAPITALIZE(THE($corpse))} contorts horribly.

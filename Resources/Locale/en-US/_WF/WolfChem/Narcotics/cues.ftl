# What a high looks like on examine. Face lines need uncovered eyes; body lines are movement, seen through a suit.

wf-drug-cue-stimulant-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } pupils are blown wide and { POSS-ADJ($target) } jaw keeps working.[/color]
wf-drug-cue-stimulant-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } can't keep still: quick, clipped movements, always shifting.[/color]
wf-drug-cue-stimulant-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "jerk", "jerks") } from one movement to the next, shaking between them.[/color]

wf-drug-cue-opioid-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } pupils are pinpoints and { POSS-ADJ($target) } eyelids keep sinking.[/color]
wf-drug-cue-opioid-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "move", "moves") } slowly, dragging, as if wading.[/color]
wf-drug-cue-opioid-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "sag", "sags") } where { SUBJECT($target) } { CONJUGATE-BASIC($target, "stand", "stands") }, barely holding { REFLEXIVE($target) } up.[/color]

wf-drug-cue-psychedelic-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } pupils are huge and { POSS-ADJ($target) } gaze slides off you to something else.[/color]
wf-drug-cue-psychedelic-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "keep", "keeps") } turning to look at things that aren't there.[/color]
wf-drug-cue-psychedelic-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "flinch", "flinches") } and { CONJUGATE-BASIC($target, "reach", "reaches") } at empty air.[/color]

wf-drug-cue-empathogen-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } pupils are wide, { POSS-ADJ($target) } face flushed and damp with sweat.[/color]
wf-drug-cue-empathogen-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "sway", "sways") } loosely, never quite standing still.[/color]
wf-drug-cue-empathogen-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "rock", "rocks") } on { POSS-ADJ($target) } feet, movements loose and overheated.[/color]

wf-drug-cue-cannabinoid-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } eyes are red and heavy-lidded.[/color]
wf-drug-cue-cannabinoid-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "move", "moves") } a beat behind everything.[/color]
wf-drug-cue-cannabinoid-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "drift", "drifts") } to a stop mid-movement, then { CONJUGATE-BASIC($target, "remember", "remembers") } to go on.[/color]

wf-drug-cue-combat-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } eyes are fixed and unblinking, veins standing out at the temples.[/color]
wf-drug-cue-combat-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "hold", "holds") } { REFLEXIVE($target) } wound tight, every movement too hard.[/color]
wf-drug-cue-combat-body-overdose = [color=#e08a5c]{ CAPITALIZE(POSS-ADJ($target)) } whole frame shudders in time with a racing pulse.[/color]

wf-drug-cue-drunk-face = [color=#d9b382]{ CAPITALIZE(POSS-ADJ($target)) } face is flushed and { POSS-ADJ($target) } eyes are glassy.[/color]
wf-drug-cue-drunk-body-heavy = [color=#d9b382]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "sway", "sways") } on { POSS-ADJ($target) } feet.[/color]
wf-drug-cue-drunk-body-overdose = [color=#e08a5c]{ CAPITALIZE(SUBJECT($target)) } can barely stay upright, lurching to keep { POSS-ADJ($target) } balance.[/color]

wf-drug-cue-crash = [color=#a8a8a8]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "move", "moves") } like someone worn out, shoulders down.[/color]

wf-drug-cue-withdrawal-face = [color=#a8a8a8]{ CAPITALIZE(POSS-ADJ($target)) } face is grey and slick with sweat, eyes sunken.[/color]
wf-drug-cue-withdrawal-body-2 = [color=#a8a8a8]{ CAPITALIZE(POSS-ADJ($target)) } hands won't keep still.[/color]
wf-drug-cue-withdrawal-body-3 = [color=#a8a8a8]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BE($target) } hunched and shaking, hugging { POSS-ADJ($target) } own arms.[/color]

wf-drug-cue-synth-face = [color=#8fc7d9]{ CAPITALIZE(POSS-ADJ($target)) } optics flicker, refocusing on nothing.[/color]
wf-drug-cue-synth-body-heavy = [color=#8fc7d9]{ CAPITALIZE(POSS-ADJ($target)) } movements stutter, a frame behind { REFLEXIVE($target) }.[/color]
wf-drug-cue-synth-body-overdose = [color=#e08a5c]{ CAPITALIZE(POSS-ADJ($target)) } limbs jerk and catch, as if something else were driving.[/color]
wf-drug-cue-synth-crash = [color=#a8a8a8]{ CAPITALIZE(POSS-ADJ($target)) } servos run slow, every motion on low power.[/color]
wf-drug-cue-synth-withdrawal = [color=#a8a8a8]{ CAPITALIZE(SUBJECT($target)) } { CONJUGATE-BASIC($target, "keep", "keeps") } repeating the same small motion, over and over.[/color]

wf-crew-role-paramedic = Paramedic
wf-crew-role-surgeon = Surgeon

wf-crew-medic-arrive-1 = Medic! Hold still.
wf-crew-medic-arrive-2 = I've got you. Stay with me.
wf-crew-medic-arrive-3 = Easy now, let me see.
wf-crew-medic-take-in-1 = Let's get you to Medical.
wf-crew-medic-take-in-2 = Moving you to a bed. Hang on.
wf-crew-medic-take-in-3 = You're coming with me.
wf-crew-medic-delivered-1 = There. The doctor will see you.
wf-crew-medic-delivered-2 = You're in Medical now.
wf-crew-medic-delivered-3 = Rest. We'll take it from here.

wf-crew-medic-doing-shock = {CAPITALIZE(THE($medic))} puts the paddles on {THE($patient)}.
wf-crew-medic-doing-cpr = {CAPITALIZE(THE($medic))} starts chest compressions on {THE($patient)}.
wf-crew-medic-doing-tourniquet = {CAPITALIZE(THE($medic))} ties a tourniquet on {THE($patient)}.
wf-crew-medic-doing-dress = {CAPITALIZE(THE($medic))} dresses {THE($patient)}'s bleeding.
wf-crew-medic-doing-stimulant = {CAPITALIZE(THE($medic))} gives {THE($patient)} a stimulant.
wf-crew-medic-doing-antitoxin = {CAPITALIZE(THE($medic))} gives {THE($patient)} an antitoxin.
wf-crew-medic-doing-brute = {CAPITALIZE(THE($medic))} patches up {THE($patient)}'s injuries.
wf-crew-medic-doing-burn = {CAPITALIZE(THE($medic))} treats {THE($patient)}'s burns.

# M3: the surgeon and the autodoc.
wf-crew-surgeon-take-in-1 = You need the autodoc. Let's go.
wf-crew-surgeon-take-in-2 = This needs surgery. Into the pod with you.
wf-crew-surgeon-take-in-3 = Hold on, I'm taking you to the autodoc.
wf-crew-surgeon-operating-1 = Starting the autodoc. Sleep well.
wf-crew-surgeon-operating-2 = Pod's running. This won't take long.
wf-crew-surgeon-operating-3 = Count backwards from ten.
wf-crew-surgeon-done-1 = All done. Back to bed with you.
wf-crew-surgeon-done-2 = That's the pod finished. Let's get you comfortable.
wf-crew-surgeon-done-3 = Out you come. Rest now.

# The surgeon at the operating table, when no pod is free.
wf-crew-surgeon-table-1 = No pod free. We'll do this on the table.
wf-crew-surgeon-table-2 = The autodoc's taken. Table it is.
wf-crew-surgeon-table-3 = Onto the table with you. I'll do it by hand.
wf-crew-surgeon-cutting-1 = Going under now. See you on the other side.
wf-crew-surgeon-cutting-2 = Scalpel. Steady... there.
wf-crew-surgeon-cutting-3 = Hold still. Or don't; you won't feel it.
wf-crew-surgeon-table-step = {CAPITALIZE(THE($medic))} works on {THE($patient)}'s {$part}.
wf-crew-surgeon-table-done-1 = That's the last stitch. Back to bed with you.
wf-crew-surgeon-table-done-2 = All closed up. Let's get you comfortable.
wf-crew-surgeon-table-done-3 = Done. You'll want to rest now.

# M4: cloning from the ship's genetic records (the surgeon's or the body scanner's).
wf-crew-surgeon-verb-register = Put me on file for cloning
wf-crew-surgeon-verb-register-message = Have the surgeon take your genetic record, so he can clone you if you die.
wf-crew-surgeon-verb-withdraw = Take me off file for cloning
wf-crew-surgeon-verb-withdraw-message = Have the surgeon delete your genetic record.
wf-crew-surgeon-registered = Hold still... done. You're on file, {$name}. If the worst happens, I'll bring you back.
wf-crew-surgeon-withdrawn = Your record's deleted. Be careful out there.
wf-crew-surgeon-register-no-database = There's no genetic database aboard I can use.
wf-crew-surgeon-register-refused = I can't take your record.
wf-crew-surgeon-cloning = Starting the cloner for {$name}.

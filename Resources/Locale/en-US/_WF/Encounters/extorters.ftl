wf-encounter-name-extorter-light = Reaver toll boat {$designation}
wf-encounter-name-extorter-medium = Reaver toll cutter {$designation}
wf-encounter-name-extorter-heavy = Reaver toll gunship {$designation}

wf-bounty-title-extorter-light = Toll boat
wf-bounty-title-extorter-medium = Toll cutter
wf-bounty-title-extorter-heavy = Toll gunship

wf-bounty-desc-extorter-light = {$ship} is a small Reaver boat with a green crew. It stops ships for a toll and boards those that don't pay. Every toll paid is added here. Paid when its crew is dead or the ship is gone.
wf-bounty-desc-extorter-medium = {$ship} is an armed Reaver cutter with a steady crew. It stops ships for a toll and boards those that don't pay. Every toll paid is added here. Paid when its crew is dead or the ship is gone.
wf-bounty-desc-extorter-heavy = {$ship} is a Reaver gunship with a veteran crew. It stops ships for a toll and boards those that don't pay. Every toll paid is added here. Paid when its crew is dead or the ship is gone.

# Said down the hail channel once the ship answers. $ship is the ship being stopped.
wf-encounter-extort-demand-1 = {$ship}, this is a Reaver toll. {$toll} spesos and you fly on.
wf-encounter-extort-demand-2 = {$ship}. You are in our space. Pay {$toll} spesos or we board you.
wf-encounter-extort-demand-3 = Heave to, {$ship}. The toll is {$toll} spesos. Pay it or we come aboard.
wf-encounter-extort-option-pay = Pay {$toll} spesos
wf-encounter-extort-option-refuse = Refuse

wf-encounter-extort-paid-1 = Paid. You are clear. Fly on.
wf-encounter-extort-paid-2 = Good. We are done with you.
wf-encounter-extort-paid-3 = Smart. Stay out of our way.

wf-encounter-extort-short-1 = You don't have {$toll} spesos. Then we take it out of your hold.
wf-encounter-extort-short-2 = Your account is short. We are coming aboard.
wf-encounter-extort-short-3 = No money, no pass. Stand by to be boarded.

wf-encounter-extort-refused-1 = Wrong answer. Stand by to be boarded.
wf-encounter-extort-refused-2 = Then we take it ourselves. We are coming aboard.
wf-encounter-extort-refused-3 = Your choice. Boarding now.

wf-encounter-extort-timeout-1 = Out of time. We are coming aboard.
wf-encounter-extort-timeout-2 = Too slow. Stand by to be boarded.
wf-encounter-extort-timeout-3 = No answer is a no. Boarding now.

# Said on the common radio channel when a hail cannot ring aboard a ship it is alongside: no powered console, running
# dark, or its line is busy.
wf-encounter-extort-dead-1 = {$ship}, your line is dead. Answer our hail or we board you.
wf-encounter-extort-dead-2 = {$ship}, we can't raise you. Pick up or be boarded.
wf-encounter-extort-dead-3 = {$ship}, hiding from a hail won't save you. Answer it.

# Said on the common radio channel after the last hail goes unanswered, as there is no channel open.
wf-encounter-extort-silent-1 = {$ship}, three hails and no answer. We are coming aboard.
wf-encounter-extort-silent-2 = {$ship}, you had your chance to talk. Stand by to be boarded.
wf-encounter-extort-silent-3 = Nobody home on {$ship}? We will see for ourselves. Boarding.

# The admin's encounter window and wf_encounter list.
wf-encounter-extort-status-roam = roaming
wf-encounter-extort-status-close = closing on {$ship}
wf-encounter-extort-status-hail = hailing {$ship} (attempt {$attempt})
wf-encounter-extort-status-demand = waiting for an answer from {$ship}
wf-encounter-extort-status-board = boarding {$ship}
wf-encounter-extort-status-nobody = no ship
wf-encounter-admin-state-detail = {$state}, {$detail}
wf-encounter-admin-state-pool = {$state}, pool {$pool}

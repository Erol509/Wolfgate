# What is printed on the card
wf-scratch-ticket-card-top-prize = WIN UP TO { $amount }!
wf-scratch-ticket-card-match = ×{ $count }
wf-scratch-ticket-card-key-left = WINNING
wf-scratch-ticket-card-key-right = SYMBOL
wf-scratch-ticket-card-game = GAME { $number }
wf-scratch-ticket-card-serial = No. CPL-{ $serial }
wf-scratch-ticket-card-dud = NOTHING
wf-scratch-ticket-card-won = WINNER! This ticket pays { $amount }.
wf-scratch-ticket-card-lost = Not a winner. Better luck on the next one.

wf-scratch-ticket-mother-lode-title = MOTHER LODE
wf-scratch-ticket-mother-lode-tagline = STRIKE THREE ORES ALIKE AND THE VEIN IS YOURS
wf-scratch-ticket-mother-lode-dud = SPOIL
wf-scratch-ticket-foundry-title = FOUNDRY GOLD
wf-scratch-ticket-foundry-tagline = FIND THE WINNING INGOT AND THE CAST IS YOURS
wf-scratch-ticket-foundry-dud = SLAG
wf-scratch-ticket-tycoon-title = THALER TYCOON
wf-scratch-ticket-tycoon-tagline = TWO ALIKE IN ANY GAME AND RETIRE A TYCOON
wf-scratch-ticket-tycoon-dud = CHANGE
wf-scratch-ticket-card-small-print-redeem = Winners are paid at any bank ATM. Void if eaten.
wf-scratch-ticket-card-small-print-issuer = Caelestinus Prospectors' Lottery

wf-scratch-ticket-examine-fresh = The foil is [color=silver]unscratched[/color].
wf-scratch-ticket-examine-won = It is a [color=gold]winner[/color], worth { $amount } at an ATM.
wf-scratch-ticket-examine-lost = It has been scratched and won [color=gray]nothing[/color].

wf-scratch-ticket-pile-no-hand = You need a free hand to pull a ticket out.

wf-scratch-ticket-atm-fresh = The ATM won't read a ticket with its foil still on.
wf-scratch-ticket-atm-lost = The ATM spits the losing ticket back out.
wf-scratch-ticket-atm-paid = The ATM takes the ticket and pays { $amount } into your account.
wf-scratch-ticket-atm-paid-cash = The ATM takes the ticket and pays out { $amount } in cash.

# Scratches-to-Win, the ticket seller in the Caelestinus Central bar
wf-scratch-seller-greeting = Tickets, tickets! One good scratch and you never haul ore again.
wf-scratch-seller-farewell = May your claws find diamonds.
wf-scratch-seller-prompt-shop = I'll take a ticket.
wf-scratch-seller-response-shop = Fresh off the roll. Pick a lucky one, or take a banded pack of ten or twenty.
wf-scratch-seller-prompt-how = How does it work?
wf-scratch-seller-response-how = Hold the ticket and rub the silver off. Every card prints how it wins and what it pays. Mother Lode wants three ores alike; it is cheap and pays often. Foundry Gold shows you a winning ingot to find among your six; it costs more and always pays back at least its price when it wins. Thaler Tycoon is three games of two, and a game with both alike wins; mostly it pays nothing, and once in a long while it pays five million. Feed a winner to any ATM and the money lands in your account.
wf-scratch-seller-prompt-who = Who are you?
wf-scratch-seller-response-who = Scratches-to-Win. I scratched one ticket, won enough to buy the whole roll, and I have been selling the rest ever since. Never found a second winner. That means they are all still in here.

wf-lattice-enter-moored = Back in anchored space. The Lattice holds here.
wf-lattice-enter-slack = Leaving anchored space. Restricted space: {$band}. Unsafe. Trust your instruments less.
wf-lattice-enter-adrift = Restricted space: {$band}. Unsafe. The Lattice barely holds here.
wf-lattice-enter-untethered = Restricted space: {$band}. The Lattice does not reach here. FTL drives are dead. Turn back.
wf-lattice-enter-deep = {$band}. Nothing holds here.

wf-lattice-ftl-dead = The FTL drive won't spool. Nothing out here holds still enough to jump from.
wf-lattice-ftl-target-dead = The FTL drive won't lock on. Nothing out there holds still enough to jump to.

ent-WFLatticeAnchorMarker = reality anchor
    .desc = Holds the Lattice field.
ent-WFLatticeAnchorRelayMarker = relay anchor
    .desc = Holds a little of the Lattice field.

wf-lattice-phantom-contact = Unknown contact

wf-lattice-radio-wrap = [color={$color}]\[Common\] [bold]{$name}[/bold] says, "{$message}"[/color]
wf-lattice-radio-name = Unknown

wf-lattice-whisper-1 = The hull creaks in a rhythm. It sounds like counting.
wf-lattice-whisper-2 = Your hands feel slightly too far away.
wf-lattice-whisper-3 = You were just somewhere else. You can't remember where.
wf-lattice-whisper-4 = Someone is standing behind you. Nobody is there.
wf-lattice-whisper-5 = The stars outside are in the wrong places.
wf-lattice-whisper-6 = You hear your own voice from the next room.
wf-lattice-whisper-7 = The deck tilts. The instruments say it didn't.
wf-lattice-whisper-8 = Something is pulling at you from the direction of the black hole.
wf-lattice-whisper-9 = You count the crew. You get one too many.
wf-lattice-whisper-10 = The lights are a colour that doesn't have a name.
wf-lattice-whisper-11 = The air tastes of metal and old blood.
wf-lattice-whisper-12 = For a moment you forget which way is out.

wf-lattice-radio-1 = ...can anyone hear me... the anchor's gone dark...
wf-lattice-radio-2 = ...we're still out here... we never left...
wf-lattice-radio-3 = ...turn around. Turn around. Turn around...
wf-lattice-radio-4 = ...it's so quiet out here... why is it so quiet...
wf-lattice-radio-5 = ...this is the relief crew, we're coming to get you...
wf-lattice-radio-6 = ...don't trust the scanner. It's lying...
wf-lattice-radio-7 = ...the Lattice is holding. The Lattice is holding. The Lattice is...
wf-lattice-radio-8 = ...I can see your ship from here...

wf-lattice-fake-ship-1 = ISV Tern
wf-lattice-fake-ship-2 = Kestrel Relief
wf-lattice-fake-ship-3 = Anchor Tender 6
wf-lattice-fake-ship-4 = MSV Harrow
wf-lattice-fake-ship-5 = Lattice Survey Two
wf-lattice-fake-ship-6 = ISV Quiet Return
wf-lattice-fake-ship-7 = Drydock Tug 41
wf-lattice-fake-ship-8 = SRV Patience

wf-lattice-hail-1 = This is {$ship}. We have you on scope. Hold position, we're coming alongside.
wf-lattice-hail-2 = {$ship} to the ship off our bow. Are you receiving? Please respond.
wf-lattice-hail-3 = This is {$ship}, we're lost. We've been lost for a long time. Can we follow you home?
wf-lattice-hail-4 = {$ship} here. We're right behind you. Don't look.
wf-lattice-hail-5 = This is {$ship}. Your transponder says you've been dead for six days.
wf-lattice-hail-6 = {$ship} hailing. We have your crew aboard. They want to talk to you.

wf-material-exotic-matter = exotic matter

ent-WFMaterialExoticMatter = exotic matter
    .desc = A shard of something that shouldn't hold together. It does anyway, and it's worth a fortune.
    .suffix = Full
ent-WFMaterialExoticMatter1 = exotic matter
    .desc = A shard of something that shouldn't hold together. It does anyway, and it's worth a fortune.
    .suffix = 1
ent-WFLatticeStabiliser = Drift stabiliser
    .desc = Holds a little anchored space round the ship it's bolted to. Needs a lot of power.
ent-WFFlatpackLatticeStabiliser = Drift stabiliser flatpack
    .desc = A flatpack used for building a Drift stabiliser.
ent-WFLatticeCharm = anchor charm
    .desc = A shard of exotic matter on a chain. Worn round the neck, it keeps your head clearer out past the Lattice.

ent-WFLatticeAnchorCoreAlpha = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorCoreBeta = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorCoreGamma = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorCoreDelta = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorCoreEpsilon = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorCoreZeta = reality anchor
    .desc = One of the Lattice's original anchors. Its glyphs hum in a key you feel in your teeth, and it holds the sector together.
ent-WFLatticeAnchorShield = anchor shield generator
    .desc = Fortress-grade shielding round a reality anchor. It draws on the anchor itself, so it never runs dry.
ent-WFLatticeRelayAnchor = relay anchor
    .desc = A small reality anchor. Bolted down on a parked hull with power, it pushes anchored space out round it.
ent-WFLatticeSpireTurret = lattice spire
    .desc = An old alien spire. It turns to follow you.
ent-WFLatticeStationAnchor = station anchor
    .desc = The station's own reality anchor. While it stands and has power, the station is anchored space, however far out it is.
ent-WFFlatpackLatticeRelay = relay anchor flatpack
    .desc = A flatpack used for building a relay anchor.


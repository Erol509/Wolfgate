light_mode unshaded;

uniform highp vec3 color;
uniform highp vec3 color2;
uniform highp float alpha;
uniform highp float intensity;
uniform highp float gridScale;
uniform highp float t;

// Procedural reproduction of the Skyrat MOD mask sheet's 4-shade diagonal checker.
// No sampler, array or engine change is involved, so the pattern cannot silently fail.
highp float maskAt(highp vec2 uv) {
    highp vec2 cells = floor(uv * 8.0);
    highp float coarse = mod(cells.x + cells.y, 4.0) / 3.0;
    highp float fine = mod(floor(uv.x * 16.0) + floor(uv.y * 16.0), 2.0);
    return mix(coarse, fine, 0.2);
}

void fragment() {
    highp vec4 base = texture2D(TEXTURE, UV);

    highp vec2 uv = UV * (gridScale / 32.0);
    uv.x += sin((UV.y * 6.0 - t * 2.0)) * 0.035;
    uv.y += sin((UV.x * 5.0 + t * 1.5)) * 0.015;
    uv = clamp(uv, 0.0, 1.0);

    highp float maskPattern = maskAt(uv);

    highp float scan = 0.82 + 0.18 * sin((UV.y + t * 0.5) * 42.0);
    highp float travel = fract(UV.y - t * 0.25);
    highp float band = smoothstep(0.0, 0.12, travel) * (1.0 - smoothstep(0.12, 0.3, travel));

    highp vec3 tint = mix(color2, color, maskPattern) * (0.95 + 0.35 * band) * intensity;
    tint += color * 0.12 * band * scan;

    highp float shape = 0.15 + 0.85 * maskPattern;
    COLOR = vec4(tint, base.a * alpha * shape * scan);
}

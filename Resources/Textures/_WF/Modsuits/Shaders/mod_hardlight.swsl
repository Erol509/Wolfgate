light_mode unshaded;

uniform highp vec3 color;
uniform highp vec3 color2;
uniform highp float alpha;
uniform highp float intensity;
uniform highp float maskScale;
uniform sampler2D maskTex;

void fragment() {
    highp vec4 base = texture2D(TEXTURE, UV);

    // Tile the theme's 32x32 Skyrat mask over the sprite and cut it to the sprite's silhouette.
    highp vec4 maskSample = texture2D(maskTex, fract(UV * maskScale));
    highp float shade = clamp(dot(base.rgb, vec3(0.299, 0.587, 0.114)), 0.0, 1.0);

    highp vec3 tint = maskSample.rgb * intensity;
    tint *= mix(0.75, 1.0, shade);

    COLOR = vec4(tint, base.a * alpha);
}

light_mode unshaded;

uniform highp vec3 color;
uniform highp vec3 color2;
uniform highp float alpha;
uniform highp float intensity;
uniform highp float gridScale;
uniform highp float t;

// Screen-space reproduction of the Skyrat MOD mask sheet's 4-shade diagonal checker.
// Screen space is used because sprite-layer UVs are atlas-relative, which made a UV
// checker collapse into a flat film. No sampler, array or engine change is involved.
highp float maskAt(highp vec2 screen) {
    highp vec2 cells = floor(screen / 8.0);
    highp float coarse = mod(cells.x + cells.y, 4.0) / 3.0;
    highp float fine = mod(floor(screen.x / 4.0) + floor(screen.y / 4.0), 2.0);
    return mix(coarse, fine, 0.2);
}

void fragment() {
    highp vec4 base = texture2D(TEXTURE, UV);

    highp vec2 screen = FRAGCOORD.xy;

    highp float maskPattern = maskAt(screen);

    highp float scan = 0.82 + 0.18 * sin((SCREEN_UV.y + t * 0.5) * 420.0);
    highp float travel = fract(SCREEN_UV.y - t * 0.25);
    highp float band = smoothstep(0.0, 0.12, travel) * (1.0 - smoothstep(0.12, 0.3, travel));

    highp vec3 tint = mix(color2, color, maskPattern) * (0.95 + 0.35 * band) * intensity;
    tint += color * 0.12 * band * scan;

    highp float shape = 0.15 + 0.85 * maskPattern;
    COLOR = vec4(tint, base.a * alpha * shape * scan);
}

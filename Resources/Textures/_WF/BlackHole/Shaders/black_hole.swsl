light_mode unshaded;

#include "/Textures/_FarHorizons/Shaders/shader_utils.swsl"
#include "/Textures/_FarHorizons/Shaders/StarSystem/planet_rings.swsl"

uniform highp vec2 starWorldPos;
uniform highp float starRadius;
uniform highp vec3 starColor;
uniform highp float starLuminosity;
uniform highp float rotationAngle;
uniform highp vec2 viewportMin;
uniform highp vec2 viewportSize;
uniform highp vec2 parallaxCenter;

uniform highp float parallaxFactor;
uniform highp float solarRadiusFactor;
uniform highp float effectRadius;
uniform highp float diskTilt;
uniform highp float rotationSpeed;
uniform highp float lensStrength;
uniform bool hasBackground;
uniform sampler2D SCREEN_TEXTURE;
uniform highp vec2 worldToScreenX;
uniform highp vec2 worldToScreenY;
// How far the Lattice has failed, 0 to 1. From the first anchor lost: stronger, twisting lensing, split light, polar jets,
// a stuttering violet disk and a ghost image. Past half: veins, a torn disk, tendrils from a beating shadow, and an eye.
uniform highp float unmooring;
// Tacet: how far through its swell it is, 0 to 1. It shudders and burns brighter as it grows.
uniform highp float swell;

// Differential rotation winds the turbulence into narrow, continuous plasma streams.
highp vec4 accretionDisk(highp vec2 q, highp float pixelWidth, highp vec3 baseColor, highp float diskTime) {
    highp float r = length(q);
    highp float inner = hasRings ? max(1.25, ringsRadiusInner * 0.8) : 1.28;
    highp float outer = hasRings ? max(inner + 0.5, ringsRadiusOuter * 1.6) : 4.16;
    if (r < inner - pixelWidth || r > outer) {
        return vec4(0.0);
    }

    highp float angle = atan(q.y, q.x);
    highp float orbit = angle - diskTime * rotationSpeed / pow(max(r, 1.0), 0.65);
    highp vec2 flow = vec2(cos(orbit), sin(orbit));
    highp float turbulence = fbm(flow * 9.0 + vec2(r * 7.0, r * 3.0));
    highp float filaments = sin(r * 85.0 + turbulence * 3.5 + sin(orbit * 7.0 + r * 4.0));
    filaments *= 1.0 - smoothstep(0.45, 1.2, pixelWidth * 85.0);
    highp float broadBands = sin(r * 24.0 + turbulence * 4.0);
    highp float texture = clamp(0.68 + turbulence * 0.48 + filaments * 0.19 + broadBands * 0.12, 0.12, 1.2);
    highp float rim = smoothstep(inner - pixelWidth, inner + max(0.12, pixelWidth), r);
    highp float fade = 1.0 - smoothstep(outer * 0.56, outer, r);
    highp float heat = pow(inner / max(r, inner), 1.8);
    highp float approaching = 0.5 - 0.5 * q.x / max(r, 0.001);
    highp float beaming = mix(0.48, 1.85, approaching * approaching);

    highp vec3 ember = baseColor * vec3(1.3, 0.40, 0.12);
    highp vec3 hot = mix(vec3(1.4, 1.05, 0.62), vec3(0.85, 1.1, 1.5), approaching * 0.65);
    highp vec3 radiance = mix(ember, hot, heat * heat) * texture * beaming * (0.65 + heat * 2.8);
    highp vec3 color = vec3(1.0) - exp(-radiance);
    highp float alpha = rim * fade * clamp(texture * 1.2, 0.0, 0.97);
    return vec4(color, alpha);
}

// Turns v by angle a.
highp vec2 turn(highp vec2 v, highp float a) {
    highp float c = cos(a);
    highp float s = sin(a);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}

// Twin jets along the spin axis (q.y): a precessing white core in knots inside a crimson sheath; the receding one dimmer.
highp vec4 polarJets(highp vec2 q, highp float strength) {
    highp float h = abs(q.y);
    highp float upper = q.y >= 0.0 ? 1.0 : 0.0;
    highp float reach = mix(1.8, 5.1, strength);
    highp float wobble = sin(h * 1.7 - TIME * 1.4 + 3.14159 * (1.0 - upper)) * 0.12 * h * strength;
    highp float width = 0.05 + 0.07 * h;
    highp float x = q.x - wobble;
    highp float coreX = x / (width * 0.35);
    highp float core = exp(-coreX * coreX);
    highp float sheathX = x / width;
    highp float sheath = exp(-sheathX * sheathX);
    highp float knots = 0.55 + 0.45 * sin(h * 7.0 - TIME * 9.0) + 0.35 * fbm(vec2(h * 3.0 - TIME * 2.0, x * 8.0));
    highp float span = smoothstep(0.85, 1.35, h) * (1.0 - smoothstep(reach * 0.45, reach, h));
    highp vec3 color = min(mix(vec3(0.9, 0.08, 0.18), vec3(1.0, 0.85, 1.0), core) * (0.7 + core * 0.6), vec3(1.0));
    highp float alpha = clamp((core * 0.9 + sheath * 0.45) * knots * span * mix(0.55, 1.0, upper) * strength, 0.0, 0.95);
    return vec4(color, alpha);
}

// An almond eye inside the shadow that opens, blinks every few seconds and turns its slit pupil towards the viewer.
highp vec4 watcher(highp vec2 p, highp vec2 look, highp float strength) {
    highp float cycle = mod(TIME, 9.0);
    highp float open = smoothstep(0.0, 0.5, cycle) * (1.0 - smoothstep(8.6, 8.9, cycle));
    highp vec2 e = p - look * 0.16;
    highp float lidShape = 0.5 * open * max(1.0 - (p.x * p.x) / 0.6724, 0.0);
    highp float almond = 1.0 - smoothstep(lidShape - 0.03, lidShape, abs(p.y));
    highp float d = length(e);
    highp float iris = 1.0 - smoothstep(0.30, 0.36, d);
    highp float fibres = 0.5 + 0.5 * fbm(vec2(atan(e.y, e.x) * 6.0, d * 14.0 - TIME * 0.2));
    highp float pupil = (1.0 - smoothstep(0.035, 0.06, abs(e.x))) * (1.0 - smoothstep(0.24, 0.28, abs(e.y)));
    highp vec3 sclera = vec3(0.16, 0.02, 0.03) * (0.6 + 0.4 * fibres);
    highp vec3 color = mix(sclera, vec3(0.85, 0.08, 0.12) * fibres, iris) * (1.0 - pupil);
    return vec4(color, almond * strength * 0.9);
}

void fragment() {
    highp float u = clamp(unmooring, 0.0, 1.0);
    // Stages: grim from the first anchor lost (twist, jets, split light), dread past half (veins, tendrils, the eye).
    highp float grim = smoothstep(0.1, 0.5, u);
    highp float dread = smoothstep(0.45, 0.9, u);
    // A double heartbeat that swells the shadow and pumps the veins.
    highp float beat = pow(max(sin(TIME * 2.6), 0.0), 12.0) + 0.6 * pow(max(sin(TIME * 2.6 - 0.7), 0.0), 12.0);
    // The disk's clock skips in jumps as the Lattice fails, and its colour leans from warm orange towards violet.
    highp float diskTime = TIME + u * 0.45 * floor(sin(TIME * 2.3) * 3.0);
    highp vec3 tint = mix(starColor, vec3(0.62, 0.30, 1.25), u * 0.85);
    highp vec2 center = starWorldPos + (parallaxCenter - starWorldPos) * (1.0 - parallaxFactor);
    highp float radius = max(starRadius * solarRadiusFactor, 0.001);
    highp vec2 offset = viewportMin + UV * viewportSize - center;
    highp vec2 p = offset / radius;
    p += vec2(sin(TIME * 37.0), cos(TIME * 29.0)) * 0.05 * swell * swell;
    highp float r = length(p);
    if (r > effectRadius) {
        discard;
    }

#ifdef HAS_DFDX
    highp float pixelWidth = max(length(fwidth(p)), 0.001);
#else
    highp float pixelWidth = 0.006;
#endif
    // Space winds itself round the hole, hardest at the shadow, so the disk wrings into a spiral.
    highp float twist = grim * (1.5 + 0.3 * sin(TIME * 0.8)) * exp(-max(r - 1.0, 0.0) * 0.7);
    highp vec2 pt = turn(p, twist);
    highp float cosR = cos(rotationAngle);
    highp float sinR = sin(rotationAngle);
    highp vec2 disk = vec2(pt.x * cosR + pt.y * sinR, -pt.x * sinR + pt.y * cosR);
    highp vec2 axis = vec2(p.x * cosR + p.y * sinR, -p.x * sinR + p.y * cosR);
    highp float tilt = clamp(diskTilt, 0.08, 0.65);

    // Only the space background is captured; ships and nearby bodies draw after this pass.
    highp float lensEnvelope = 1.0 - smoothstep(2.4, effectRadius, r);
    highp float bend = lensStrength * (1.0 + u * 1.2) * lensEnvelope / (r * r + 0.55);
    highp vec2 displacement = turn(offset, twist * 0.6) * bend;
    highp vec2 displacementPixels = worldToScreenX * displacement.x + worldToScreenY * displacement.y;
    highp vec2 safeMin = SCREEN_PIXEL_SIZE * 0.5;
    highp vec2 safeMax = vec2(1.0) - safeMin;
    highp vec4 composite = vec4(0.0);
    if (hasBackground) {
        // Protect rays aimed beyond the capture without fading safe inward refraction at screen edges.
        highp vec2 screenUv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
        highp vec2 sampleShift = -displacementPixels * SCREEN_PIXEL_SIZE;
        highp vec2 edgeRoom = vec2(
            sampleShift.x < 0.0 ? screenUv.x - safeMin.x : safeMax.x - screenUv.x,
            sampleShift.y < 0.0 ? screenUv.y - safeMin.y : safeMax.y - screenUv.y);
        highp vec2 shift = abs(sampleShift);
        highp float edgeFade = smoothstep(0.0, 1.0, min(
            edgeRoom.x / max(shift.x * 1.5, 0.001),
            edgeRoom.y / max(shift.y * 1.5, 0.001)));
        // Failing, the light splits: red and blue bend by different amounts.
        highp vec2 bent = sampleShift * edgeFade;
        highp float split = 0.12 * grim;
        composite = vec4(
            zTextureSpec(SCREEN_TEXTURE, clamp(screenUv + bent * (1.0 + split), safeMin, safeMax)).r,
            zTextureSpec(SCREEN_TEXTURE, clamp(screenUv + bent, safeMin, safeMax)).g,
            zTextureSpec(SCREEN_TEXTURE, clamp(screenUv + bent * (1.0 - split), safeMin, safeMax)).b,
            1.0);
    }

    // Soft emission gives the disk a halo without requiring a separate bloom pass.
    highp float equatorial = length(vec2(disk.x, disk.y / (tilt + 0.16)));
    highp float haze = exp(-equatorial * 0.8) * (1.0 - smoothstep(3.5, effectRadius, r));
    haze *= 1.0 + swell * swell * 3.0;
    highp vec3 halo = tint * haze * 0.12;
    composite = compositeOver(composite, vec4(halo, clamp(haze * 0.38, 0.0, 0.9)));

    // Crawling veins in the haze, pumping with the heartbeat.
    if (dread > 0.0) {
        highp float vein = 1.0 - smoothstep(0.0, 0.035, abs(fbm(pt * 1.8 + vec2(TIME * 0.04, -TIME * 0.03))));
        highp float veinZone = smoothstep(1.05, 1.4, r) * (1.0 - smoothstep(3.0, effectRadius, r));
        composite = compositeOver(composite, vec4(0.5, 0.02, 0.07, vein * veinZone * dread * (0.4 + 0.4 * beat)));
    }

    highp vec4 directDisk = accretionDisk(vec2(disk.x, disk.y / tilt), pixelWidth / tilt, tint, diskTime);
    // Past half the disk tears into ragged streamers.
    highp float shred = fbm(vec2(atan(disk.y, disk.x) * 4.0 - TIME * 0.3, length(disk) * 3.0));
    directDisk.a *= 1.0 - dread * 0.75 * smoothstep(-0.1, 0.35, shred);
    // A wrong second image of the disk, turned a little and running against the first.
    if (u > 0.01) {
        highp float ghostAngle = 0.35 + 0.1 * sin(TIME * 0.7);
        highp vec2 ghostQ = turn(disk, ghostAngle);
        highp vec4 ghost = accretionDisk(vec2(ghostQ.x, ghostQ.y / tilt) * 1.08, pixelWidth / tilt, tint, -diskTime);
        ghost.a *= u * 0.45;
        composite = compositeOver(composite, ghost);
    }

    // Jets burst from the poles once the first anchor is gone; their bases hide behind the shadow.
    if (grim > 0.0) {
        composite = compositeOver(composite, polarJets(axis, grim));
    }

    if (disk.y >= 0.0) {
        composite = compositeOver(composite, directDisk);
    }

    // Analytic secondary images wrap the far side of the disk above and below the shadow.
    highp float arcRadius = length(vec2(disk.x, disk.y * 0.90));
    highp float arcT = (arcRadius - 1.045) / 0.52;
    if (arcT > 0.0 && arcT < 1.0) {
        highp float sourceRadius = mix(1.28, 4.16, arcT);
        highp vec2 arcDirection = vec2(disk.x, disk.y * 0.90) / max(arcRadius, 0.001);
        highp vec4 arc = accretionDisk(arcDirection * sourceRadius, pixelWidth * 6.0, tint, diskTime);
        highp float upper = smoothstep(-0.1, 0.3, disk.y);
        highp float arch = smoothstep(0.05, 0.42, abs(disk.y));
        arc.a *= arch * mix(0.28, 0.93, upper) * (1.0 - smoothstep(0.65, 1.0, arcT));
        composite = compositeOver(composite, arc);
    }

    // The shadow's edge tears as the Lattice fails, then reaches out in curling tendrils and swells with each beat.
    highp float twistedAngle = atan(pt.y, pt.x);
    highp float tear = u * 0.12 * fbm(vec2(atan(p.y, p.x) * 3.0, TIME * 0.6))
        + dread * 0.6 * pow(max(fbm(vec2(twistedAngle * 5.0, r * 0.8 - TIME * 0.5)), 0.0), 1.5);
    highp float swell = 1.0 + dread * 0.07 * beat;
    highp float shadow = 1.0 - smoothstep(swell - pixelWidth, swell + pixelWidth, r - tear);
    composite = compositeOver(composite, vec4(0.0, 0.0, 0.0, shadow));

    // Something inside opens its eye.
    if (dread > 0.0) {
        highp vec2 toViewer = parallaxCenter - starWorldPos;
        highp vec2 look = toViewer / max(length(toViewer), 1.0);
        highp vec4 eye = watcher(p, look, dread);
        eye.a *= 1.0 - smoothstep(0.8, 0.95, r);
        composite = compositeOver(composite, eye);
    }

    // A narrow photon ring stays legible at distance; its broad halo is outside the shadow. It stutters near the end.
    highp float ringWidth = max(0.012, pixelWidth);
    highp float photon = exp(-pow((r - 1.035) / ringWidth, 2.0));
    highp float ringGlow = exp(-abs(r - 1.055) * 24.0) * (1.0 - shadow);
    highp float flicker = 1.0 - dread * 0.6 * step(0.7, fract(sin(floor(TIME * 12.0)) * 43758.5453));
    highp float brightness = (0.76 + 0.24 * (-disk.x / max(r, 0.001))) * flicker;
    highp vec3 ringColor = mix(tint, vec3(1.0, 0.96, 0.85), photon);
    composite = compositeOver(composite, vec4(ringColor * brightness, clamp(photon * 0.95 + ringGlow * 0.35, 0.0, 1.0) * flicker));

    if (disk.y < 0.0) {
        composite = compositeOver(composite, directDisk);
    }

    COLOR = composite;
}

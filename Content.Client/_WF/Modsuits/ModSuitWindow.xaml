<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc modsuit-ui-title}"
    MinSize="600 540"
    SetSize="600 600">
    <PanelContainer HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1F2C3A" />
        </PanelContainer.PanelOverride>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="6">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">

                <!-- Suit Status / User Status -->
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">

                    <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#151D27" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                            <PanelContainer>
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#151D27" BorderColor="#3E5774" BorderThickness="0 0 0 2" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6" SeparationOverride="6">
                                    <Label Text="{Loc modsuit-ui-suit-status}"
                                           StyleClasses="LabelHeading"
                                           FontColorOverride="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalExpand="True" />
                                    <Button Name="ActivateButton" MinWidth="104" />
                                </BoxContainer>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="3">
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                                    <Label Text="{Loc modsuit-ui-charge-label}"
                                           FontColorOverride="#8091A6"
                                           MinWidth="96"
                                           VerticalAlignment="Center" />
                                    <PanelContainer Name="ChargeBorder" HorizontalExpand="True" MinHeight="20">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BackgroundColor="#00000080" BorderColor="#3E5774" BorderThickness="1" />
                                        </PanelContainer.PanelOverride>
                                        <Control>
                                            <ProgressBar Name="ChargeBar" MinValue="0" MaxValue="1" MinHeight="20" />
                                            <Label Name="ChargeText"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0 0 6 0"
                                                   FontColorOverride="#FFFFFF" />
                                        </Control>
                                    </PanelContainer>
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                                    <Label Text="{Loc modsuit-ui-id-lock}"
                                           FontColorOverride="#8091A6"
                                           MinWidth="96"
                                           VerticalAlignment="Center" />
                                    <Button Name="IdLockButton" Disabled="True" Text="{Loc modsuit-ui-unlocked}" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                                    <Label Text="{Loc modsuit-ui-modlink}"
                                           FontColorOverride="#8091A6"
                                           MinWidth="96"
                                           VerticalAlignment="Center" />
                                    <Button Name="ModLinkButton" Disabled="True" Text="{Loc modsuit-ui-frequency-unset}" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Name="CoverRow" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4" Visible="False">
                                    <Label Text="{Loc modsuit-ui-cover}"
                                           FontColorOverride="#8091A6"
                                           MinWidth="96"
                                           VerticalAlignment="Center" />
                                    <Label Text="{Loc modsuit-ui-cover-open}"
                                           FontColorOverride="#DC2323"
                                           VerticalAlignment="Center" />
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#151D27" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                            <PanelContainer>
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#151D27" BorderColor="#3E5774" BorderThickness="0 0 0 2" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6">
                                    <Label Text="{Loc modsuit-ui-user-status}"
                                           StyleClasses="LabelHeading"
                                           FontColorOverride="#FFFFFF"
                                           VerticalAlignment="Center" />
                                </BoxContainer>
                            </PanelContainer>
                            <Control VerticalExpand="True">
                                <BoxContainer Name="UserStatusList" Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="3">
                                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                                        <Label Text="{Loc modsuit-ui-user-name}"
                                               FontColorOverride="#8091A6"
                                               MinWidth="96"
                                               VerticalAlignment="Center" />
                                        <Label Name="UserNameLabel" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" />
                                    </BoxContainer>
                                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                                        <Label Text="{Loc modsuit-ui-user-assignment}"
                                               FontColorOverride="#8091A6"
                                               MinWidth="96"
                                               VerticalAlignment="Center" />
                                        <Label Name="UserAssignmentLabel" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" />
                                    </BoxContainer>
                                </BoxContainer>
                                <PanelContainer Name="UserDimmer" HorizontalExpand="True" VerticalExpand="True" Visible="False">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#000000BF" />
                                    </PanelContainer.PanelOverride>
                                    <Label Text="{Loc modsuit-ui-suit-unpowered}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontColorOverride="#4A90FF"
                                           StyleClasses="LabelHeading" />
                                </PanelContainer>
                            </Control>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <!-- Modules -->
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#151D27" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <PanelContainer>
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#151D27" BorderColor="#3E5774" BorderThickness="0 0 0 2" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6" SeparationOverride="6">
                                <Label Text="{Loc modsuit-ui-modules}"
                                       StyleClasses="LabelHeading"
                                       FontColorOverride="#FFFFFF"
                                       VerticalAlignment="Center"
                                       HorizontalExpand="True" />
                                <Label Name="ModulesInfoLabel"
                                       FontColorOverride="#8091A6"
                                       VerticalAlignment="Center" />
                            </BoxContainer>
                        </PanelContainer>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="4">
                            <BoxContainer Name="ModulesHeader" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="2" />
                            <BoxContainer Name="ModulesList" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <!-- Hardware -->
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#151D27" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <PanelContainer>
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#151D27" BorderColor="#3E5774" BorderThickness="0 0 0 2" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6">
                                <Label Text="{Loc modsuit-ui-hardware}"
                                       StyleClasses="LabelHeading"
                                       FontColorOverride="#FFFFFF"
                                       VerticalAlignment="Center" />
                            </BoxContainer>
                        </PanelContainer>
                        <BoxContainer Name="HardwareList" Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="3" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</controls:FancyWindow>

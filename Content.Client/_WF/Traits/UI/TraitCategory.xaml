<PanelContainer xmlns="https://spacestation14.io"
                StyleClasses="CreatorCard"
                HorizontalExpand="True"
                Margin="0 0 0 8">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <Button Name="HeaderButton" StyleClasses="LinkButton" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Name="ExpandIcon" Text="▾" MinWidth="14" VAlign="Center" />
                <Label Name="CategoryNameLabel" StyleClasses="CreatorHeading" VAlign="Center" />
                <Control HorizontalExpand="True" />
                <Label Name="CategoryStatsLabel" StyleClasses="CreatorFieldLabel" VAlign="Center" />
            </BoxContainer>
        </Button>
        <BoxContainer Name="TraitsContainer"
                      Orientation="Vertical"
                      HorizontalExpand="True"
                      SeparationOverride="4"
                      Margin="0 6 0 0" />
    </BoxContainer>
</PanelContainer>

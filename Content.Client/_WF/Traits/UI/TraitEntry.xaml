<PanelContainer xmlns="https://spacestation14.io"
                StyleClasses="CreatorInset"
                HorizontalExpand="True"
                Margin="0 0 0 4">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 6">
        <CheckBox Name="TraitCheckbox" VerticalAlignment="Top" Margin="0 2 8 0" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Name="TraitNameLabel" StyleClasses="CreatorFieldLabel" />
                <Control HorizontalExpand="True" />
                <Label Name="TraitCostLabel" StyleClasses="CreatorFieldLabel" />
            </BoxContainer>
            <RichTextLabel Name="TraitDescriptionLabel"
                           HorizontalExpand="True"
                           Margin="0 2 0 0" />
            <RichTextLabel Name="TraitNotesLabel"
                           HorizontalExpand="True"
                           Visible="False"
                           Margin="0 4 0 0" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>

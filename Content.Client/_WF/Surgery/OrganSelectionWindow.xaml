<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="280 320"
               Title="{Loc 'surgery-organ-select-title'}">
    <BoxContainer Orientation="Vertical" SeparationOverride="6">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" MinSize="0 220">
            <BoxContainer Name="Options" Access="Public" Orientation="Vertical"
                          HorizontalExpand="True" VerticalExpand="True" />
        </ScrollContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <Button Name="ConfirmButton" Access="Public" Text="{Loc 'surgery-organ-select-confirm'}"
                    HorizontalExpand="True" MinSize="0 28" StyleClasses="ButtonColorGreen" />
            <Button Name="CancelButton" Access="Public" Text="{Loc 'surgery-organ-select-cancel'}"
                    HorizontalExpand="True" MinSize="0 28" StyleClasses="ButtonColorRed" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>

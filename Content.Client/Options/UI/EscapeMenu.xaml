<!-- WOLFGATE(Census): census namespace for the Census button -->
<ui1:EscapeMenu xmlns="https://spacestation14.io"
            xmlns:changelog="clr-namespace:Content.Client.Changelog"
            xmlns:ui="clr-namespace:Content.Client.Voting.UI"
            xmlns:ui1="clr-namespace:Content.Client.Options.UI"
            xmlns:census="clr-namespace:Content.Client._WF.Census"
            Title="{Loc 'ui-escape-title'}"
            Resizable="False">

    <BoxContainer Orientation="Vertical" SeparationOverride="4" MinWidth="150">
        <changelog:ChangelogButton Access="Public" Name="ChangelogButton"/>
        <!-- WOLFGATE(Roadmap): roadmap entry under the changelog -->
        <Button Access="Public" Name="RoadmapButton" Text="{Loc 'wf-roadmap-button'}" />
        <!-- WOLFGATE(SectorControl): sector map entry under the roadmap -->
        <Button Access="Public" Name="SectorMapButton" Text="{Loc 'wf-sector-map-button'}" />
        <!-- WOLFGATE(Feedback): bug report and suggestion entry, green so players find it -->
        <Button Access="Public" Name="FeedbackButton" Text="{Loc 'wf-feedback-button'}" StyleClasses="ButtonColorGreen" />
        <!-- WOLFGATE(Census): census list with the count yet to answer -->
        <census:CensusButton Access="Public" Name="CensusButton" />
        <ui:VoteCallMenuButton />
        <!-- WOLFGATE(InRoundCreator): opens the character creator over the round -->
        <Button Access="Public" Name="CharacterButton" Text="{Loc 'wf-escape-character-creator'}" ToolTip="{Loc 'wf-escape-character-creator-tooltip'}" />
        <!-- WOLFGATE(RoundSetup): hosts can manage admission and survivors after spawning -->
        <Button Access="Public" Name="RoundSetupButton" Text="{Loc 'wf-round-setup-title'}" />
        <!-- WOLFGATE(MappingMode): session, save and library window while mapping -->
        <Button Access="Public" Name="MappingButton" Text="{Loc 'wf-mapping-mode-escape-button'}" Visible="False" />
        <Button Access="Public" Name="OptionsButton" Text="{Loc 'ui-escape-options'}" />
        <Button Access="Public" Name="RulesButton" Text="{Loc 'ui-escape-rules'}" />
        <Button Access="Public" Name="GuidebookButton" Text="{Loc 'ui-escape-guidebook'}" />
        <!-- WOLFGATE(LoreBook): lore book entry under the guidebook -->
        <Button Access="Public" Name="LoreBookButton" Text="{Loc 'wf-lore-book-button'}" />
        <Button Access="Public" Name="WikiButton" Text="{Loc 'ui-escape-wiki'}" />
        <Button Access="Public" Name="DisconnectButton" Text="{Loc 'ui-escape-disconnect'}" />
        <Button Access="Public" Name="QuitButton" Text="{Loc 'ui-escape-quit'}" />
    </BoxContainer>
</ui1:EscapeMenu>

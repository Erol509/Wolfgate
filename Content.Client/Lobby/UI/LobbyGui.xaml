    <!-- WOLFGATE(RoundSetup) START: retain the repository lobby menu and hero with dedicated crew and ready actions -->
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Vertical" SeparationOverride="0">
        <roundSetup:WFLobbyLayout Name="LobbyColumns" DockChat="True" HorizontalExpand="True" VerticalExpand="True" Margin="24 24 24 16">
            <BoxContainer Name="LeftSide" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="0">
                <roundSetup:WFLobbyLayout Name="DefaultState" HeroLayout="True" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Name="LobbyMenu" Orientation="Vertical" SeparationOverride="0" Margin="16 8 0 8">
                        <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Vertical" SeparationOverride="0">
                            <RichTextLabel Name="ServerName" Access="Public" StyleClasses="LobbyTitle" />
                            <PanelContainer StyleClasses="LobbyTitleRule" MinHeight="4" Margin="0 2 0 4" />
                            <Label Name="StartTime" Access="Public" StyleClasses="LobbyStatus" />
                        </BoxContainer>
                        <Control MinHeight="20" />
                        <BoxContainer Orientation="Vertical" SeparationOverride="6">
                            <Button Name="RoundSetupButton" Access="Public" TextAlign="Left" MinHeight="52"
                                    Text="{Loc 'wf-round-setup-home-setup'}" StyleClasses="WFLobbyCrewAction" />
                            <Button Name="ReadyButton" Access="Public" TextAlign="Left" MinHeight="52"
                                    Text="{Loc 'wf-round-setup-home-ready'}" StyleClasses="LobbyNavPrimary" />
                            <!-- WOLFGATE(Feedback): big green bug report and suggestion entry -->
                            <Button Name="FeedbackButton" Access="Public" TextAlign="Left" MinHeight="52"
                                    Text="{Loc 'wf-feedback-button'}" StyleClasses="LobbyNavPrimary ButtonColorGreen" />
                        </BoxContainer>
                        <Control MinHeight="12" />
                        <ScrollContainer Name="LobbyMenuScroll" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Orientation="Vertical" SeparationOverride="0">
                                <Button Name="CustomizeButton" Access="Public" TextAlign="Left"
                                        Text="{Loc 'ui-lobby-customize-nav-button'}" StyleClasses="LobbyNav" />
                                <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public" TextAlign="Left"
                                                    Text="{Loc 'ui-lobby-observe-button'}" StyleClasses="LobbyNav"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                <vote:VoteCallMenuButton Name="CallVoteButton" TextAlign="Left" StyleClasses="LobbyNav" />
                                <Button Name="OptionsButton" Access="Public" TextAlign="Left"
                                        Text="{Loc 'ui-lobby-options-button'}" StyleClasses="LobbyNav" />
                                <!-- WOLFGATE(LoreBook): lore book entry in the lobby menu -->
                                <Button Name="LoreBookButton" Access="Public" TextAlign="Left"
                                        Text="{Loc 'wf-lore-book-button'}" StyleClasses="LobbyNav" />
                                <Button Name="AHelpButton" Access="Public" TextAlign="Left"
                                        Text="{Loc 'ui-lobby-ahelp-nav-button'}" StyleClasses="LobbyNav" />
                                <Button Name="LeaveButton" Access="Public" TextAlign="Left"
                                        Text="{Loc 'ui-lobby-leave-nav-button'}" StyleClasses="LobbyNav" />
                                <roundSetup:WFRoundSetupLobbyPanel Name="ActiveCrews" Margin="0 12 0 0" VerticalExpand="True" />
                            </BoxContainer>
                        </ScrollContainer>
                        <ScrollContainer HScrollEnabled="False" ReturnMeasure="True" MaxHeight="120" Margin="0 12 0 0">
                            <info:ServerInfo Name="ServerInfo" Access="Public" StyleClasses="LobbyInfo" />
                        </ScrollContainer>
                    </BoxContainer>
                    <BoxContainer Name="CharacterHero" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="0 16" SeparationOverride="8">
                        <!-- WOLFGATE(Symphony): the notice staff set from the SSymphony panel; hidden when there is none -->
                        <lobbyUi:SymphonyLobbyNotice Name="SymphonyNotice" />
                        <Control VerticalExpand="True" />
                        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Control VerticalExpand="True" />
                    </BoxContainer>
                </roundSetup:WFLobbyLayout>
                <Control Name="CharacterSetupState" Access="Public" Visible="False" HorizontalExpand="True" VerticalExpand="True" />
            </BoxContainer>
            <PanelContainer Name="RightSide" Access="Public" StyleClasses="LobbyChatPanel" VerticalExpand="True" RectClipContent="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="4">
                    <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical" SeparationOverride="4" />
                    <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" HorizontalExpand="True" MinSize="0 50" />
                </BoxContainer>
            </PanelContainer>
        </roundSetup:WFLobbyLayout>
        <PanelContainer Name="LobbyUtilities" StyleClasses="LobbyBar" HorizontalExpand="True">
            <ScrollContainer Name="LobbyLinksScroll" VScrollEnabled="False" HScrollEnabled="True" HorizontalExpand="True" ReturnMeasure="True" Margin="24 6">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="24">
                    <info:LinkBanner Name="LinkBanner" StyleClasses="LobbyLinks" VerticalAlignment="Center" />
                    <info:DevInfoBanner Name="DevInfoBanner" StyleClasses="LobbyLinks" VerticalAlignment="Center" />
                    <Label Name="StationTime" Access="Public" StyleClasses="LobbyBarText" VAlign="Center" />
                    <Control HorizontalExpand="True" />
                    <RichTextLabel Name="LobbySong" Access="Public" StyleClasses="LobbyBarText" VerticalAlignment="Center" MaxWidth="480" />
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
    <PanelContainer Name="SkinScanlines" StyleClasses="LobbyScanlines" MouseFilter="Ignore" Visible="False" />
    <!-- WOLFGATE(LobbyShenanigans): the layer the lobby fun plays on, over everything and never taking a click -->
    <shenanigans:LobbyShenanigansLayer Name="ShenaniganLayer" />
    <!-- WOLFGATE END -->
</lobbyUi:LobbyGui>
